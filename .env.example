# Optional. Manual mode works without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional USD per 1 million tokens; obtain current rates for your chosen model.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
DATABASE_PATH=data/reading.db
# Optional independent pinyin review (defaults to OPENAI_MODEL).
OPENAI_PINYIN_MODEL=
# If review and story models differ, set review-specific prices for estimates.
OPENAI_PINYIN_INPUT_USD_PER_MILLION=
OPENAI_PINYIN_OUTPUT_USD_PER_MILLION=
